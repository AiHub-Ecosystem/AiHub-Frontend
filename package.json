{
  "name": "@aihub/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --concurrency=1",
    "dev:web": "npm run dev --workspace=@aihub/customer-web",
    "build:web": "npm run build --workspace=@aihub/customer-web",
    "start": "npm run start:web",
    "start:web": "npm run start --workspace=@aihub/customer-web",
    "lint": "eslint",
    "test": "vitest run",
    "generate:aihub-contract": "node scripts/check-aihub-contract.mjs --write-limits",
    "check:aihub-contract": "node scripts/check-aihub-contract.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "start:landing": "npm run start --workspace=@aihub/landing"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "turbo": "^2.11.10",
    "vitest": "^4.1.11"
  }
}
