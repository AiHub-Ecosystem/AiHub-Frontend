{
  "name": "@aihub/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/landing"
  ],
  "scripts": {
    "dev": "turbo run //#dev:web dev",
    "build": "turbo run //#build:web build --concurrency=1",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "generate:aihub-contract": "node scripts/check-aihub-contract.mjs --write-limits",
    "check:aihub-contract": "node scripts/check-aihub-contract.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "dev:web": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:e2e:secondary": "next dev --hostname 127.0.0.1 --port 3105",
    "build:web": "next build",
    "start:web": "next start",
    "start:landing": "npm run start --workspace=@aihub/landing"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.46.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "turbo": "^2.11.10",
    "vitest": "^4.1.11"
  }
}
