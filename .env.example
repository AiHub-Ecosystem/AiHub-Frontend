# Demo gateway (server-only; never expose these values as NEXT_PUBLIC_*).
# The BFF refuses any host other than these two pinned ones, and never falls
# back from one to the other: a missing URL is an error, not a silent switch.
AIHUB_SANDBOX_BASE_URL=https://sandbox.aihubproduction.com
AIHUB_PRODUCTION_BASE_URL=https://api.aihubproduction.com
AIHUB_WEB_SESSION_CLIENT_SECRET=replace_with_the_server_only_bff_secret
