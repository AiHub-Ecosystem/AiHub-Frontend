{
  "extends": "./apps/customer-web/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/customer-web/*"],
      "@spikes/*": ["./spikes/*"]
    }
  },
  "include": [
    "apps/customer-web/next-env.d.ts",
    "apps/customer-web/**/*.ts",
    "apps/customer-web/**/*.tsx",
    "apps/customer-web/.next/types/**/*.ts",
    "apps/customer-web/.next/dev/types/**/*.ts",
    "apps/customer-web/**/*.mts",
    "apps/customer-web/.next-e2e-secondary/types/**/*.ts",
    "apps/customer-web/.next-e2e-secondary/dev/types/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "*.mts"
  ],
  "exclude": ["node_modules"]
}
